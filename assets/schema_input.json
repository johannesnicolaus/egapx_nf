{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/johannesnicolaus/egapx_nf/master/assets/schema_input.json",
    "title": "johannesnicolaus/egapx_nf pipeline - params.input schema (genomes)",
    "description": "One row per genome to annotate",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "genome_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]+$",
                "errorMessage": "genome_id must be provided and may only contain letters, digits, '_' and '.'",
                "meta": [
                    "id"
                ]
            },
            "fasta": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fna)$",
                "errorMessage": "Genome FASTA must exist, be uncompressed and end in .fa, .fasta or .fna"
            },
            "evidence_group": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+$",
                "errorMessage": "evidence_group must match a group in the --reads samplesheet (letters, digits, '_')",
                "meta": [
                    "evidence_group"
                ]
            },
            "taxid": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "taxid must be the NCBI Taxonomy ID of the organism",
                "meta": [
                    "taxid"
                ]
            },
            "size_class": {
                "type": "string",
                "enum": [
                    "small",
                    "large"
                ],
                "default": "small",
                "errorMessage": "size_class must be 'small' or 'large'",
                "meta": [
                    "size_class"
                ]
            },
            "reference_gff": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(gff|gff3|gtf)(\\.gz)?$",
                "errorMessage": "reference_gff must be an existing GFF/GTF file (optional)"
            },
            "id_prefix": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]+$",
                "errorMessage": "id_prefix may only contain letters and digits (used in gene IDs, e.g. I25P_chr1g000010)",
                "meta": [
                    "id_prefix"
                ]
            }
        },
        "required": [
            "genome_id",
            "fasta",
            "evidence_group",
            "taxid"
        ]
    },
    "uniqueEntries": [
        "genome_id"
    ]
}

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // EGAPx needs a cluster and hours of runtime, so the pipeline test is a stub run that checks the wiring:
    // samplesheet parsing, name sanitising, evidence channels, EGAPx inputs and QC steps.
    // The test samplesheets (conf/test.config) use paths relative to the repository root.
    test("-profile test -stub") {

        options "-stub"

        when {
            params {
                outdir          = "$outputDir"
                egapx_cache_dir = "$outputDir/egapx_cache"
                egapx_workdir   = "$outputDir/egapx_work"
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert path("$outputDir/egapx/test_genome/complete.genomic.gff").exists() },
                { assert path("$outputDir/egapx_input/test_genome.egapx.yaml").exists() },
                { assert path("$outputDir/evidence/testgroup/short_reads/lib_B.counts.tsv").exists() },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() }
            )
        }
    }
}

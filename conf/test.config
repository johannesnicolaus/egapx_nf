/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run . -profile test,singularity -stub --outdir <OUTDIR>   (from the repository root)

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Tiny test data in tests/data (run from the repository root). EGAPx itself cannot run on such a
    // small dataset, so the full test is meant for -stub runs; the evidence steps run for real.
    input                 = 'tests/data/genomes.csv'
    reads                 = 'tests/data/reads.csv'
    max_pairs_per_library = 20000
    egapx_cache_dir       = "${launchDir}/test_egapx_cache"
    egapx_workdir         = "${launchDir}/test_egapx_work"
    egapx_executor        = 'singularity'
    egapx_extra_yaml      = 'tests/data/egapx_extra.yaml'
}

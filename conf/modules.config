/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [ path: { "${params.outdir}/qc/fastqc/${meta.evidence_group}" }, mode: params.publish_dir_mode, pattern: '*.html' ]
    }

    //
    // RNA-seq evidence
    //
    withName: 'SRATOOLS_PREFETCH|SRATOOLS_FASTERQDUMP' {
        publishDir = [ enabled: false ]
    }
    withName: 'SRATOOLS_FASTERQDUMP' {
        ext.args = '--split-files --include-technical'
    }
    withName: 'BARRNAP|BEDTOOLS_GETFASTA' {
        publishDir = [ path: { "${params.outdir}/evidence/rrna_reference" }, mode: params.publish_dir_mode ]
    }
    withName: 'BEDTOOLS_GETFASTA' {
        ext.args = '-s'
    }
    withName: 'BBMAP_BBDUK' {
        // pair removed when either mate matches the rRNA reference
        ext.args   = 'k=31 hdist=1'
        ext.prefix = { "${meta.id}.norrna" }
        publishDir = [ path: { "${params.outdir}/evidence/${meta.evidence_group}/rrna_removal" }, mode: params.publish_dir_mode, pattern: '*.log' ]
    }
    withName: 'SUBSAMPLE_READS' {
        publishDir = [
            path: { "${params.outdir}/evidence/${meta.evidence_group}/short_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.counts.tsv') || params.save_prepared_reads ? filename : null }
        ]
    }
    withName: 'PREPARE_LONG_READS' {
        publishDir = [
            path: { "${params.outdir}/evidence/${meta.evidence_group}/long_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.stats.tsv') || params.save_prepared_reads ? filename : null }
        ]
    }

    //
    // EGAPx
    //
    withName: 'MAKE_EGAPX_INPUT|RELAXED_CHAINER_YAML' {
        publishDir = [ path: { "${params.outdir}/egapx_input" }, mode: params.publish_dir_mode ]
    }
    withName: 'EGAPX_SETUP|EGAPX_DOWNLOAD' {
        publishDir = [ enabled: false ]
    }
    withName: 'EGAPX_RUN_SMALL' {
        maxForks   = params.max_parallel_small
        publishDir = [ path: { "${params.outdir}/egapx" }, mode: params.publish_dir_mode ]
    }
    withName: 'EGAPX_RUN_LARGE' {
        maxForks   = params.max_parallel_large
        publishDir = [ path: { "${params.outdir}/egapx" }, mode: params.publish_dir_mode ]
    }

    withName: 'RESCUE_SINGLE_EXON' {
        publishDir = [ path: { "${params.outdir}/annotation/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.rescued_genes.tsv' ]
    }
    withName: 'RENAME_ANNOTATION' {
        publishDir = [ path: { "${params.outdir}/annotation/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{gff3,gtf,faa,fna,tsv}' ]
    }

    //
    // Annotation QC
    //
    withName: 'LONGEST_PROTEINS|CDS_GTF' {
        publishDir = [ path: { "${params.outdir}/qc/proteins" }, mode: params.publish_dir_mode, pattern: '*.faa' ]
    }
    withName: 'BUSCO_BUSCO' {
        ext.args   = { params.busco_lineages_path || params.busco_lineage == null ? '--offline' : '' }
        publishDir = [ path: { "${params.outdir}/qc/busco" }, mode: params.publish_dir_mode, pattern: '{short_summary.*,*-busco.batch_summary.txt}' ]
    }
    withName: 'GFFCOMPARE' {
        publishDir = [ path: { "${params.outdir}/qc/gffcompare" }, mode: params.publish_dir_mode ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
